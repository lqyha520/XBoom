[Unit]
Description=XBoom singleton scheduler
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/www/wwwroot/xboom-current
ExecStart=/www/wwwroot/xboom/venv/bin/python /www/wwwroot/xboom-current/scripts/run_scheduler.py
Restart=always
RestartSec=5
TimeoutStopSec=3600
KillSignal=SIGTERM
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
